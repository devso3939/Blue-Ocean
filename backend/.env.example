# Blue Ocean backend environment template.
# Copy this file to .env and fill in what you need. All values are optional —
# the backend runs fine without any of them.

# --- LLM insights (optional; falls back to deterministic briefs) ---
# OpenAI-compatible endpoint. Groq example:
#   BLUEOCEAN_LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
#   BLUEOCEAN_LLM_MODEL=llama-3.3-70b-versatile
# BLUEOCEAN_LLM_API_KEY=

# --- Data dir (Fly mounts a volume at /data) ---
# BLUEOCEAN_DATA_DIR=/data

# --- Politeness / tuning ---
# BLUEOCEAN_NOMINATIM_INTERVAL=1.0
# BLUEOCEAN_JOB_WORKERS=2
# BLUEOCEAN_USER_AGENT=BlueOceanOpportunityIntel/0.1 (contact: you@example.com)
# BLUEOCEAN_OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://overpass.private.coffee/api/interpreter
