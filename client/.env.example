# ── Blue Ocean v6.5.0 — Free-tier API keys (all OPTIONAL) ──────────────
# Copy this file to `.env` and paste your keys. Every key unlocks extra
# contact-discovery engines; the app works fully without any of them.
# NOTE: These are Vite frontend keys (baked into the build). For private
# repos/personal use this is fine; for public deployments use restricted
# keys with domain/origin limits and low spend caps.

# Brave Search API — 2,000 free queries/month (already used by the app)
# https://brave.com/search/api/
VITE_BRAVE_API_KEY=

# Serper.dev — Google SERP API, 2,500 free credits (no credit card)
# https://serper.dev  → unlocks the "Serper" enrichment engine
VITE_SERPER_API_KEY=

# Tavily — AI-optimized search, 1,000 free searches/month
# https://tavily.com  → unlocks the "Tavily" enrichment engine
VITE_TAVILY_API_KEY=

# OpenRouter — LLM access, free models ~50 requests/day
# https://openrouter.ai  → upgrades AI analysis quality over Pollinations
VITE_OPENROUTER_API_KEY=
# Optional: pick any ":free" model from https://openrouter.ai/models
VITE_OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
